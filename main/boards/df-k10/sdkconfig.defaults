CONFIG_BOARD_TYPE_DF_K10=y

# ESP32-S3-WROOM-1-N16R8: 16 MB flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_SPIRAM_MODE_OCT=y

# Keep GPIO19/20 reserved for native USB Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# GC2145 on the K10 DVP camera connector.
CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC2145_DVP_RGB565_640X480_15FPS=y
CONFIG_XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP=n

# Use the English "Computer" WakeNet model instead of the ESP32-S3 default.
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_WN_WN9_COMPUTER_TTS=y

# Agent Hub ships with an English, conversation-first home screen.
CONFIG_LANGUAGE_ZH_CN=n
CONFIG_LANGUAGE_EN_US=y
CONFIG_USE_DEFAULT_MESSAGE_STYLE=n
CONFIG_USE_WECHAT_MESSAGE_STYLE=y

# Agent Hub's public Funnel endpoint. switch-board.sh replaces the placeholder
# at build time when AGENT_HUB_SERVER_ENROLLMENT_TOKEN is set.
CONFIG_OTA_URL="https://agent-hub.panthera-hamlet.ts.net/xiaozhi/ota/?enrollment_token=YOUR_ENROLLMENT_TOKEN"
